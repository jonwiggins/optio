{
  "name": "optio",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jonwiggins/optio.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@optio/api",
    "dev:web": "turbo dev --filter=@optio/web",
    "dev:site": "turbo dev --filter=@optio/site",
    "build": "turbo build",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "knip": "knip",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:push": "node scripts/check-push.mjs",
    "check:changed": "node scripts/check-push.mjs --working-tree",
    "check:infra": "bash scripts/check-infra.sh",
    "prepare": "husky",
    "gen:swift": "pnpm --filter @optio/shared gen:swift",
    "gen:kotlin": "pnpm --filter @optio/shared gen:kotlin",
    "security:audit": "node scripts/audit-dependencies.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "@fastify/static": "10.1.6",
      "@grpc/grpc-js": "1.14.6",
      "@humanfs/node": "0.16.8",
      "@humanfs/node@^0.16": "0.16.8",
      "@opentelemetry/core@^2": "2.12.0",
      "@opentelemetry/propagator-jaeger@^2": "2.12.0",
      "@protobufjs/utf8": "1.1.2",
      "apns2>undici": "7.30.1",
      "axios": "1.20.0",
      "body-parser": "2.4.0",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
      "dompurify": "3.4.17",
      "esbuild": "0.28.2",
      "fast-copy": "4.3.1",
      "fast-json-stringify": "7.1.0",
      "fast-jwt": "6.3.4",
      "fast-jwt@^6": "6.3.6",
      "fast-uri": "3.1.9",
      "find-my-way": "9.10.0",
      "follow-redirects": "1.16.2",
      "form-data": "4.0.6",
      "form-data@^4": "4.0.6",
      "glob@>=9.0.0 <14.0.2": "14.0.3",
      "handlebars": "4.7.10",
      "ip-address": "10.7.5",
      "jira.js>zod": "4.6.6",
      "js-yaml@^4": "4.3.2",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.2",
      "minimatch@<11.0.1": "11.0.3",
      "nanoid@^3": "3.3.20",
      "nanoid@>=3.0.0 <4.0.0": "3.3.19",
      "postcss": "8.5.31",
      "protobufjs": "7.6.6",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici@^6": "6.29.1",
      "undici@^7": "7.30.1",
      "uuid": "11.1.1",
      "vite": "7.3.7",
      "vite@>=7.0.0 <8.0.0": "7.3.7",
      "ws": "8.22.0",
      "yaml": "2.9.1",
      "zod@^4": "4.6.7"
    },
    "patchedDependencies": {
      "zod@3.25.76": "patches/zod@3.25.76.patch",
      "@redocly/openapi-core@1.34.22": "patches/@redocly__openapi-core@1.34.22.patch"
    }
  },
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
