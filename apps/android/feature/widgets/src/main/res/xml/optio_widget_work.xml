<?xml version="1.0" encoding="utf-8"?>
<!--
  The Work widget: 2×2 (small), 4×2 (medium), 4×4 (large); Glance picks the layout for the size.
  The Server option is optional (all servers by default) and can be changed later
  (reconfigurable). updatePeriodMillis is the 30 min floor; the app's periodic work and its event
  socket refresh it more often.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.optio.feature.widgets.config.WorkWidgetConfigActivity"
    android:description="@string/widget_work_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="560dp"
    android:maxResizeWidth="560dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview_work"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
