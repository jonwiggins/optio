<?xml version="1.0" encoding="utf-8"?>
<!-- A launcher-shortcut icon: the white glyph inside the adaptive safe zone on Optio purple. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/optio_widgets_purple" />
    <foreground>
        <inset
            android:drawable="@drawable/widget_ic_play"
            android:inset="32%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/widget_ic_play"
            android:inset="32%" />
    </monochrome>
</adaptive-icon>
