<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: the terminal playground (canned ANSI, a local echo loop, and a live Optio Local
  stream). Merged into the app's debug APK because :app depends on :core:terminal:
    adb shell am start -n dev.optio.android/dev.optio.core.terminal.playground.TerminalPlaygroundActivity
  Extras: see PlaygroundConfig.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 blocks sockets to private addresses (10.0.2.2, a LAN) without this runtime permission.
      Install with `adb install -r -g` to pre-grant it, or use `adb reverse tcp:4973 tcp:4973` and
      http://127.0.0.1:4973 (loopback needs no permission; the playground's default).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application>
        <activity
            android:name="dev.optio.core.terminal.playground.TerminalPlaygroundActivity"
            android:exported="true"
            android:label="Terminal playground"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
