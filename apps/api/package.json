{
  "name": "@optio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "openapi:lint": "redocly lint openapi.generated.json",
    "openapi:types": "openapi-typescript openapi.generated.json -o openapi.generated.d.ts",
    "redis:smoke": "tsx scripts/redis-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-codecommit": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.6",
    "@kubernetes/client-node": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@optio/agent-adapters": "workspace:*",
    "@optio/container-runtime": "workspace:*",
    "@optio/shared": "workspace:*",
    "@optio/ticket-providers": "workspace:*",
    "apns2": "^12.2.0",
    "bullmq": "^5.81.5",
    "cron-parser": "^5.10.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^3.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "ldapts": "^8.2.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "tweetnacl": "^1.0.3",
    "tweetnacl-sealedbox-js": "^1.2.0",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "yaml": "2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2",
    "@node-saml/node-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.1",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "xml-crypto": "6.4.0"
  }
}
