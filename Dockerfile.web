# Optional offline inputs; defaults retain the upstream base images.
ARG NODE_SLIM_IMAGE=node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe

# Replaced with a directory or image containing store/ and pnpm.tgz.
FROM scratch AS pnpm-offline

# ---- Dependencies stage ----
FROM ${NODE_SLIM_IMAGE} AS deps

ARG PNPM_OFFLINE=0
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      mkdir -p /opt/pnpm \
      && tar -xzf /pnpm-offline/pnpm.tgz -C /opt/pnpm --strip-components=2 \
      && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
      && ln -s /opt/pnpm/bin/pnpx.cjs /usr/local/bin/pnpx; \
    else npm install -g pnpm@10.34.8; fi

WORKDIR /app

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY patches/ patches/

# Copy package.json for ALL workspace packages (pnpm needs full workspace graph)
COPY apps/api/package.json apps/api/
COPY apps/cli/package.json apps/cli/
COPY apps/web/package.json apps/web/tsconfig.json apps/web/
COPY apps/site/package.json apps/site/
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/agent-adapters/package.json packages/agent-adapters/
COPY packages/container-runtime/package.json packages/container-runtime/
COPY packages/ticket-providers/package.json packages/ticket-providers/
COPY packages/mcp-bridge/package.json packages/mcp-bridge/

# Install all dependencies (dev deps needed for build).
# --ignore-scripts (matching Dockerfile.api) skips the husky prepare hook and
# dependency build scripts — notably node-pty's node-gyp compile, which the
# root onlyBuiltDependencies allowlist would otherwise trigger; node-pty is
# only used by the CLI daemon and never runs in this image.
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline,rw \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      pnpm install --frozen-lockfile --prod=false --ignore-scripts \
        --offline --store-dir /pnpm-offline/store; \
    else pnpm install --frozen-lockfile --prod=false --ignore-scripts; fi

# ---- Builder stage ----
FROM deps AS builder

# Copy source
COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/

# Build shared packages then web
ENV NEXT_TELEMETRY_DISABLED=1

RUN if [ "$PNPM_OFFLINE" = 1 ]; then \
      TURBO_TELEMETRY_DISABLED=1 pnpm turbo build --filter=@optio/shared; \
    else pnpm turbo build --filter=@optio/shared; fi
ARG OPTIO_OFFLINE_FONTS=0
RUN if [ "$OPTIO_OFFLINE_FONTS" = 1 ]; then \
      cd apps/web && OPTIO_OFFLINE_FONTS=1 TURBO_TELEMETRY_DISABLED=1 pnpm exec next build; \
    else cd apps/web && npx next build; fi

# ---- Runtime stage ----
FROM ${NODE_SLIM_IMAGE}

ARG OPTIO_VERSION=dev
ENV OPTIO_VERSION=${OPTIO_VERSION}

WORKDIR /app

# Verify Node ships OpenSSL >= 3.5 for post-quantum TLS (X25519MLKEM768)
RUN node -e 'const [maj,min] = process.versions.openssl.split(".").map(Number); if (maj < 3 || (maj === 3 && min < 5)) { console.error("OpenSSL " + process.versions.openssl + " too old; need >= 3.5"); process.exit(1); }'

RUN apt-get update && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && npm uninstall -g npm && rm -rf /root/.npm

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone output (preserves monorepo directory structure)
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

USER node

CMD ["node", "apps/web/server.js"]
