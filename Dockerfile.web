# The node:22-slim both stages start from. Offline builds pass the copy in
# their own registry (docs/air-gapped.md, build-images.sh --offline).
ARG NODE_SLIM_IMAGE=node:22-slim

# ---- Offline build (no network): the pnpm store ----
# Empty by default. The offline kit (scripts/offline/make-kit.sh) ships the
# workspace's packages as offline/pnpm-offline-<version>.tgz (`pnpm fetch`,
# for linux/amd64 glibc = this base image) with corepack's pnpm archive beside
# them: store/ and pnpm.tgz. Unpacked somewhere, or as the kit's
# build/pnpm-offline image (scripts/offline/load-kit.sh), it replaces this
# stage and the build needs no registry (NODE_SLIM_IMAGE must be in the local
# daemon or a reachable registry):
#
#   tar xzf pnpm-offline-<version>.tgz -C /tmp/pnpm-offline
#   docker buildx build -f Dockerfile.web --network none --build-arg PNPM_OFFLINE=1 \
#     --build-arg OPTIO_OFFLINE_FONTS=1 \
#     --build-context pnpm-offline=/tmp/pnpm-offline -t optio.local/optio-web:<version> .
#
# or --build-context pnpm-offline=docker-image://<registry>/build/pnpm-offline:<version>
# (pnpm install --offline --store-dir <the mounted store>). With
# OPTIO_OFFLINE_FONTS=1, fonts come from apps/web/public/fonts via next/font/local.
# The default uses next/font/google. Telemetry is disabled during either build.
FROM scratch AS pnpm-offline

# ---- Dependencies stage ----
FROM ${NODE_SLIM_IMAGE} AS deps

# 1 = install from the pnpm-offline context above instead of the registry.
ARG PNPM_OFFLINE=0
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      corepack enable && COREPACK_ENABLE_NETWORK=0 corepack install -g --cache-only /pnpm-offline/pnpm.tgz; \
    else corepack enable && corepack prepare pnpm@10 --activate; fi

WORKDIR /app

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package.json for ALL workspace packages (pnpm needs full workspace graph)
COPY apps/api/package.json apps/api/
COPY apps/cli/package.json apps/cli/
COPY apps/web/package.json apps/web/tsconfig.json apps/web/
COPY apps/site/package.json apps/site/
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/agent-adapters/package.json packages/agent-adapters/
COPY packages/container-runtime/package.json packages/container-runtime/
COPY packages/ticket-providers/package.json packages/ticket-providers/
COPY packages/mcp-bridge/package.json packages/mcp-bridge/

# Install all dependencies (dev deps needed for build).
# --ignore-scripts (matching Dockerfile.api) skips the husky prepare hook and
# dependency build scripts — notably node-pty's node-gyp compile, which the
# root onlyBuiltDependencies allowlist would otherwise trigger; node-pty is
# only used by the CLI daemon and never runs in this image.
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline,rw \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      COREPACK_ENABLE_NETWORK=0 pnpm install --frozen-lockfile --prod=false --ignore-scripts \
        --offline --store-dir /pnpm-offline/store; \
    else pnpm install --frozen-lockfile --prod=false --ignore-scripts; fi

# ---- Builder stage ----
FROM deps AS builder

# Copy source
COPY packages/shared/ packages/shared/
COPY apps/web/ apps/web/

# Build shared packages then web
ENV NEXT_TELEMETRY_DISABLED=1
# Turborepo's telemetry too: a build with no internet access must not phone home.
ENV TURBO_TELEMETRY_DISABLED=1

RUN pnpm turbo build --filter=@optio/shared
ARG OPTIO_OFFLINE_FONTS=0
RUN OPTIO_OFFLINE_FONTS=${OPTIO_OFFLINE_FONTS} pnpm --dir apps/web exec next build

# ---- Runtime stage ----
FROM ${NODE_SLIM_IMAGE}

ARG OPTIO_VERSION=dev
ENV OPTIO_VERSION=${OPTIO_VERSION}
WORKDIR /app

# Verify Node ships OpenSSL >= 3.5 for post-quantum TLS (X25519MLKEM768)
RUN node -e 'const [maj,min] = process.versions.openssl.split(".").map(Number); if (maj < 3 || (maj === 3 && min < 5)) { console.error("OpenSSL " + process.versions.openssl + " too old; need >= 3.5"); process.exit(1); }'

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone output (preserves monorepo directory structure)
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

USER node

CMD ["node", "apps/web/server.js"]
