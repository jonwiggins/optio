#!/bin/bash
# Git credential helper — called by git with "get" on stdin.
# Supports GitHub (via Optio credential API) and GitLab (via Optio credential
# API for the asking host, else the GITLAB_TOKEN env var).
#
# Authentication: HMAC-SHA256 signature over timestamp + request path.
# The raw OPTIO_CREDENTIAL_SECRET never crosses the wire.

# Compute HMAC-SHA256 signature for an Optio internal API request.
# Usage: _optio_sign <full_url>
# Outputs: t=<timestamp>,sig=<hex_hmac>
_optio_sign() {
  local url="$1"
  local ts
  ts=$(date +%s)
  # Extract path (+ query string) from URL: strip scheme://host[:port]
  local path
  path=$(echo "$url" | sed 's|^[a-z]*://[^/]*||')
  local sig
  sig=$(printf '%s.%s' "$ts" "$path" | openssl dgst -sha256 -hmac "${OPTIO_CREDENTIAL_SECRET}" | awk '{print $NF}')
  echo "t=${ts},sig=${sig}"
}

# Lower-case, without a scheme or a trailing path: "https://Git.Corp:8443/" → "git.corp:8443"
_optio_host() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | xargs | sed -E 's|^[a-z]+://||; s|/.*$||'
}

while IFS= read -r line; do
  case "$line" in host=*) host="${line#host=}";; esac
  [ -z "$line" ] && break
done
if [ "$host" = "github.com" ]; then
  SIG=$(_optio_sign "${OPTIO_GIT_CREDENTIAL_URL}")
  TOKEN=$(curl -sf -H "X-Optio-Signature: ${SIG}" "${OPTIO_GIT_CREDENTIAL_URL}" | jq -r '.token')
  if [ -n "$TOKEN" ] && [ "$TOKEN" != "null" ]; then
    echo "protocol=https"
    echo "host=github.com"
    echo "username=x-access-token"
    echo "password=${TOKEN}"
  fi
elif [ -n "$host" ]; then
  # GitLab: the run owner's token for this host, from Optio (answered only
  # for a host the deployment named as GitLab; nothing is written to disk).
  # Only an answer naming GitLab's user is used: an API that doesn't know
  # `host` answers with GitHub's token, which is no token for this host.
  TOKEN=""
  if [ -n "${OPTIO_GIT_CREDENTIAL_URL:-}" ]; then
    case "${OPTIO_GIT_CREDENTIAL_URL}" in *\?*) sep="&" ;; *) sep="?" ;; esac
    URL="${OPTIO_GIT_CREDENTIAL_URL}${sep}host=$(jq -rn --arg h "$host" '$h|@uri')"
    SIG=$(_optio_sign "${URL}")
    TOKEN=$(curl -sf --max-time 15 -H "X-Optio-Signature: ${SIG}" "${URL}" | jq -r 'select(.username == "oauth2") | .token // empty' 2>/dev/null)
  fi
  # Else the pod's GITLAB_TOKEN, for gitlab.com or a host named in GITLAB_HOSTS
  # or GITLAB_HOST (a port on either side matches with or without it).
  if [ -z "$TOKEN" ] && [ -n "${GITLAB_TOKEN:-}" ]; then
    want=$(_optio_host "$host")
    IFS=',' read -ra hosts <<< "gitlab.com,${GITLAB_HOSTS:-},${GITLAB_HOST:-}"
    for h in "${hosts[@]}"; do
      h=$(_optio_host "$h")
      [ -z "$h" ] && continue
      if [ "$h" = "$want" ] || [ "${h%%:*}" = "${want%%:*}" ]; then
        TOKEN="${GITLAB_TOKEN}"
        break
      fi
    done
  fi
  if [ -n "$TOKEN" ]; then
    echo "protocol=https"
    echo "host=${host}"
    echo "username=oauth2"
    echo "password=${TOKEN}"
  fi
fi
