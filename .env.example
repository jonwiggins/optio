# Database
DATABASE_URL=postgres://optio:optio_dev@localhost:5432/optio

# Redis
REDIS_URL=redis://localhost:6379

# Container Runtime: "docker" | "kubernetes"
OPTIO_RUNTIME=kubernetes

# Encryption key for secrets at rest (REQUIRED — generate with: openssl rand -hex 32)
# The server will refuse to start if this is empty or set to a known-weak value.
OPTIO_ENCRYPTION_KEY=

# API server
API_PORT=4000
API_HOST=0.0.0.0

# Docker socket (for Docker runtime)
DOCKER_HOST=unix:///var/run/docker.sock

# Agent container image
# Local dev uses locally-built images; production uses ghcr.io registry
OPTIO_AGENT_IMAGE=optio-agent:latest

# Image pull policy: "Never" for local images, "Always" or "IfNotPresent" for registry
# Local dev must use "Never" since images are built with docker build, not pulled from a registry
OPTIO_IMAGE_PULL_POLICY=Never

# Authentication
# Set to "true" to disable auth entirely (for local dev)
OPTIO_AUTH_DISABLED=true

# OAuth providers (set client ID + secret to enable a provider)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=

# Generic OIDC provider (Keycloak, Authentik, Authelia, Zitadel, Okta, Auth0, etc.)
# OIDC_ISSUER_URL=https://auth.example.com/realms/optio
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=SSO
# OIDC_SCOPES=openid email profile

# GitHub webhook signature validation (generate with: openssl rand -hex 32)
# Must match the secret configured in GitHub's webhook settings
# GITHUB_WEBHOOK_SECRET=

# Optio Local automations — signed event ingress (see docs/optio-local.md)
# Slack app signing secret (Basic Information → App Credentials); Events API
# request URL is <PUBLIC_URL>/api/webhooks/slack/events
# SLACK_SIGNING_SECRET=
# Linear webhook signing secret (Settings → API → Webhooks); URL is
# <PUBLIC_URL>/api/webhooks/linear
# LINEAR_WEBHOOK_SECRET=
# PagerDuty Webhooks v3 signing secret (Integrations → Generic Webhooks (v3),
# shown once when the subscription is created); URL is
# <PUBLIC_URL>/api/webhooks/pagerduty
# PAGERDUTY_WEBHOOK_SECRET=
# GitLab webhook secret token (project / group → Settings → Webhooks); sent
# as X-Gitlab-Token; URL is <PUBLIC_URL>/api/webhooks/gitlab
# GITLAB_WEBHOOK_SECRET=
# Jira Cloud webhook secret (Settings → System → WebHooks); verified against
# X-Hub-Signature; URL is <PUBLIC_URL>/api/webhooks/jira
# JIRA_WEBHOOK_SECRET=
# Sentry internal integration Client Secret (Settings → Developer Settings);
# verified against Sentry-Hook-Signature; URL is <PUBLIC_URL>/api/webhooks/sentry
# SENTRY_WEBHOOK_SECRET=
# Pylon, Alertmanager / Grafana and Datadog need no server secret: each such
# trigger has its own, sent as X-Optio-Secret (or a Bearer token / basic-auth
# password) to <PUBLIC_URL>/api/hooks/<type>/<trigger id>

# Public URL (used for OAuth callback URLs and redirects)
# PUBLIC_URL=http://localhost:3000

# The origin the browser reaches the API at when it is not the web's own
# (NodePort, a separate host). Origin only, no /api. OAuth callbacks become
# <origin>/api/auth/<provider>/callback; unset, they derive from PUBLIC_URL.
# PUBLIC_API_URL=http://localhost:30400

# Outbound URL guard (SSRF). URLs people type that the API itself fetches
# (outbound webhooks, Slack notifications, ticket providers, connection health
# checks) never reach loopback, link-local / cloud-metadata, multicast or
# reserved addresses, and reach private ranges (10/8, 172.16/12, 192.168/16,
# 100.64/10, fc00::/7, *.internal, *.local) only when allowed below.
# OPTIO_OUTBOUND_ALLOW_PRIVATE=true
# Always-allowed hosts: names, *.suffix names, IPs or CIDRs, comma-separated;
# a listed host is allowed whatever it resolves to, loopback included.
# OPTIO_OUTBOUND_ALLOWED_HOSTS=*.svc.cluster.local,vault.internal,10.1.0.0/16
# Older switch that turns the guard off entirely (local dev only):
# OPTIO_ALLOW_PRIVATE_URLS=1

# WebSocket URL override (optional — only needed when the API runs on a different origin than the web UI)
# NEXT_PUBLIC_WS_URL=ws://localhost:4000
