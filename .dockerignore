**/node_modules
.git
**/dist
**/.next
**/.next-e2e
**/.turbo
*.tsbuildinfo
# Local dev env files must never bake into images (NEXT_PUBLIC_* is inlined at build time).
**/.env
**/.env.*
!**/.env.example
.values.local.yaml
# The native apps: never copied into an image, and their build output (Xcode's
# DerivedData, Gradle's) runs to gigabytes of build context.
apps/ios
apps/android
.pnpm-store
# Generated offline bundles can contain large image archives.
release
